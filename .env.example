# Copy to .env (gitignored) and fill in for your own Databricks account. Never commit .env.
DATABRICKS_CONFIG_PROFILE=DEFAULT        # profile in ~/.databrickscfg (holds host + credentials)
DATABRICKS_APP_PORT=8000
DATABRICKS_APP_NAME=eosl

# SQL warehouse the analytics plugin queries (Lineage Explorer data from Unity Catalog)
DATABRICKS_WAREHOUSE_ID=
# Genie space for the Ask Genie panel (optional)
DATABRICKS_GENIE_SPACE_ID=
# Set to true to use bundled sample data when no warehouse is configured (offline UI work)
EOSL_USE_MOCK_DATA=false
